{
  "schemaVersion": 1,
  "canonicalSources": [
    "AGENTS.md",
    "PRODUCT.md",
    "docs/architecture.md"
  ],
  "allowedExtensions": [
    ".css", ".html", ".js", ".json", ".md", ".mjs", ".ps1", ".rs",
    ".lock", ".sdoc", ".toml", ".ts", ".tsx", ".yml", ".yaml"
  ],
  "deniedPatterns": [
    ".git/**", "node_modules/**", "output/**", "target/**", "**/.env*",
    "**/*.key", "**/*.pem", "**/*.p12", "**/*.pfx", "media/**",
    "shared/editor/assets/**", "tauri-app/src-tauri/icons/**",
    "tests/ui/specs/__screenshots__/**"
  ],
  "safeUntrackedPatterns": [
    ".agents/skills/orchestrate-sdoc-work/**", "cli/**", "docs/**", "scripts/**",
    "shared/**", "src/**", "tauri-app/src/**", "tauri-app/src-tauri/src/**",
    "tests/**", "webview-ui/src/**"
  ],
  "routes": [
    {
      "id": "advisor-protocol",
      "concern": "advisor-protocol",
      "changedPatterns": [".agents/skills/orchestrate-sdoc-work/**"],
      "sources": [
        ".agents/skills/orchestrate-sdoc-work/SKILL.md",
        ".agents/skills/orchestrate-sdoc-work/references/external-advisors.md"
      ]
    },
    {
      "id": "document-contract",
      "concern": "document-contract",
      "changedPatterns": ["sdoc.schema.json", "shared/types.ts", "shared/document/**"],
      "sources": ["sdoc.schema.json", "shared/types.ts", "tests/fixtures/document-contract.json"]
    },
    {
      "id": "operations",
      "concern": "operations",
      "changedPatterns": ["sdoc.operations.schema.json", "shared/document/operations/**", "examples/operations/**"],
      "sources": ["sdoc.operations.schema.json", "shared/document/operations/types.ts", "tests/operations-schema.test.ts"]
    },
    {
      "id": "book",
      "concern": "book",
      "changedPatterns": ["sdocbook.schema.json", "shared/book/**", "src/SdocBookProvider.ts"],
      "sources": ["sdocbook.schema.json", "shared/book/types.ts", "tests/book-core.test.ts"]
    },
    {
      "id": "shared-editor",
      "concern": "editor-host-parity",
      "changedPatterns": ["shared/editor/**", "DESIGN.md"],
      "sources": ["DESIGN.md", "shared/editor/hostBridge.ts", "tests/editor-core.test.tsx"]
    },
    {
      "id": "shared-core",
      "concern": "shared-host-parity",
      "changedPatterns": ["shared/**"],
      "sources": ["shared/types/messages.ts", "tests/message-contract.test.ts"]
    },
    {
      "id": "vscode-host",
      "concern": "vscode-host",
      "changedPatterns": ["src/**", "webview-ui/**"],
      "sources": ["webview-ui/src/App.tsx", ".github/instructions/extension.instructions.md"]
    },
    {
      "id": "tauri-host",
      "concern": "tauri-host",
      "changedPatterns": ["tauri-app/**"],
      "sources": ["tauri-app/src/App.tsx", ".github/instructions/tauri.instructions.md"]
    },
    {
      "id": "cli",
      "concern": "cli",
      "changedPatterns": ["cli/**"],
      "sources": ["cli/README.md", "cli/src/coreAdapter.ts", "cli/tests/cli.integration.test.ts"]
    },
    {
      "id": "tests",
      "concern": "verification",
      "changedPatterns": ["tests/**"],
      "sources": ["package.json"]
    },
    {
      "id": "schema-generation",
      "concern": "document-contract",
      "changedPatterns": ["scripts/generate-document-validators.mjs", "shared/document/generated/**"],
      "sources": ["scripts/generate-document-validators.mjs", "sdoc.schema.json", "tests/document-core.test.ts"]
    },
    {
      "id": "repository-tooling",
      "concern": "repository-tooling",
      "changedPatterns": [".github/**", ".codex/**", ".vscode/**", "scripts/**", "package.json", "package-lock.json", "*.mjs", "*.json", "*.md", "*.yml", "*.yaml"],
      "sources": ["package.json", "CONTRIBUTING.md"]
    },
    {
      "id": "documentation",
      "concern": "documentation",
      "changedPatterns": ["docs/**", "README.md", "PRODUCT.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "ASSETS.md"],
      "sources": ["README.md"]
    }
  ],
  "relationships": [
    {
      "id": "shared-cross-host-and-test",
      "triggerPatterns": ["shared/**"],
      "requiredSources": ["webview-ui/src/App.tsx", "tauri-app/src/App.tsx", "tests/message-contract.test.ts"]
    },
    {
      "id": "editor-cross-host-and-test",
      "triggerPatterns": ["shared/editor/**", "DESIGN.md"],
      "requiredSources": ["webview-ui/src/components/Editor.tsx", "tauri-app/src/components/Editor.tsx", "tests/editor-core.test.tsx"]
    },
    {
      "id": "schema-types-fixture-and-native",
      "triggerPatterns": ["sdoc.schema.json", "shared/types.ts", "shared/document/**", "tauri-app/src-tauri/src/document.rs"],
      "requiredSources": ["sdoc.schema.json", "shared/types.ts", "tests/fixtures/document-contract.json", "tauri-app/src-tauri/src/document.rs", "tests/document-core.test.ts"]
    },
    {
      "id": "source-change-has-test-context",
      "triggerPatterns": ["shared/**", "src/**", "webview-ui/src/**", "tauri-app/src/**", "tauri-app/src-tauri/src/**", "cli/src/**"],
      "requiredSources": ["package.json"]
    }
  ]
}
