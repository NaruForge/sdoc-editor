{
  "name": "structured-doc-editor",
  "displayName": "Structured Doc Editor",
  "description": "Git으로 검토 가능한 .sdoc 기술 문서를 위한 VS Code WYSIWYG 편집기",
  "version": "0.13.3",
  "publisher": "swbaek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NaruForge/sdoc-editor.git"
  },
  "homepage": "https://github.com/NaruForge/sdoc-editor#readme",
  "bugs": {
    "url": "https://github.com/NaruForge/sdoc-editor/issues"
  },
  "keywords": [
    "sdoc",
    "tiptap",
    "wysiwyg",
    "structured-document",
    "markdown",
    "asciidoc"
  ],
  "icon": "media/sdoc-editor-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:structuredDocEditor.sdoc",
    "onCustomEditor:structuredDocEditor.sdocBook"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "structuredDocEditor.sdoc",
        "displayName": "Structured Doc Editor",
        "selector": [
          {
            "filenamePattern": "*.tiptap.json"
          },
          {
            "filenamePattern": "*.sdoc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "structuredDocEditor.sdocBook",
        "displayName": "Sdoc Book Editor",
        "selector": [
          {
            "filenamePattern": "*.sdocbook"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "structuredDocEditor.newSdoc",
        "title": "New .sdoc Document",
        "category": "Structured Doc"
      },
      {
        "command": "structuredDocEditor.exportToHtml",
        "title": "Export to HTML",
        "category": "Structured Doc"
      },
      {
        "command": "structuredDocEditor.exportToAdoc",
        "title": "Export to AsciiDoc",
        "category": "Structured Doc"
      },
      {
        "command": "structuredDocEditor.exportToMarkdown",
        "title": "Export to Markdown",
        "category": "Structured Doc"
      },
      {
        "command": "structuredDocEditor.exportToPdf",
        "title": "Export to PDF",
        "category": "Structured Doc"
      },
      {
        "command": "structuredDocEditor.exportToSlides",
        "title": "Export to Slides",
        "category": "Structured Doc"
      },
      {
        "command": "structuredDocEditor.toggleBold",
        "title": "Toggle Bold",
        "category": "Structured Doc"
      },
      {
        "command": "structuredDocEditor.cleanUpLegacySettings",
        "title": "Clean Up Legacy Settings",
        "category": "Structured Doc Editor"
      }
    ],
    "walkthroughs": [
      {
        "id": "structuredDocEditor.getStarted",
        "title": "Structured Doc Editor",
        "description": "Create a sample .sdoc, edit the title and body, and keep Git-reviewable structure.",
        "steps": [
          {
            "id": "create-sample",
            "title": "Create a sample document",
            "description": "Run **Structured Doc: New .sdoc Document** and choose **기능 둘러보기** (Feature showcase), or open Templates in an editor and select **Create new document**.\n[Create a document](command:structuredDocEditor.newSdoc)",
            "media": {
              "image": "media/sdoc-editor-icon.png",
              "altText": "Structured Doc Editor icon"
            },
            "completionEvents": [
              "onCommand:structuredDocEditor.newSdoc"
            ]
          },
          {
            "id": "edit-title-body",
            "title": "Edit the title and body",
            "description": "Change the document title, then type in the body. Headings, tables, math, and diagrams stay structured JSON on disk.",
            "media": {
              "image": "media/sdoc-editor-icon.png",
              "altText": "Structured Doc Editor icon"
            }
          },
          {
            "id": "open-existing",
            "title": "Open an existing document",
            "description": "Open a `.sdoc` or `.tiptap.json` file from the Explorer, or use **Open existing document** on an empty editor.",
            "media": {
              "image": "media/sdoc-editor-icon.png",
              "altText": "Structured Doc Editor icon"
            }
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "structuredDocEditor.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == structuredDocEditor.sdoc && focusedCustomEditorIsEditable && structuredDocEditor.editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "structuredDocEditor.toggleBold",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Structured Doc Editor",
      "properties": {
        "structuredDocEditor.ui.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "enumDescriptions": [
            "Use the current VS Code display language.",
            "한국어",
            "English"
          ],
          "scope": "window",
          "description": "Interface language used by Structured Doc Editor. Workspace overrides are ignored."
        },
        "structuredDocEditor.diagramRenderer.endpoint": {
          "type": "string",
          "default": "https://kroki.io",
          "scope": "window",
          "description": "Global Kroki endpoint used by the extension host. Workspace overrides are ignored."
        },
        "structuredDocEditor.diagramRenderer.allowPrivateNetwork": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Allow HTTPS Kroki endpoints on private networks. Link-local and metadata addresses remain blocked."
        },
        "structuredDocEditor.image.defaultAlignment": {
          "type": "string",
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "description": "Default alignment when inserting new images"
        },
        "structuredDocEditor.export.imagePath": {
          "type": "string",
          "default": "relative",
          "enum": [
            "relative",
            "absolute"
          ],
          "enumDescriptions": [
            "Use relative paths for images (e.g., ./images/photo.png)",
            "Use absolute file system paths for images"
          ],
          "description": "Image path format in exported documents"
        }
      }
    }
  },
  "workspaces": [
    "webview-ui",
    "cli"
  ],
  "scripts": {
    "build": "npm run validators:generate && npm run export-assets:copy && npm run build:ext && npm run build:webview",
    "build:all": "npm run build && npm run build:cli",
    "build:cli": "npm run build --workspace=sdoc-editor-cli",
    "build:ext": "node esbuild.mjs",
    "build:webview": "npm run build --workspace=webview-ui && node scripts/check-webview-assets.mjs",
    "export-assets:copy": "node scripts/copy-export-assets.mjs",
    "package": "node scripts/package-vsix.mjs",
    "package:cli": "node scripts/package-cli.mjs",
    "typecheck": "npm run typecheck:core && npm run typecheck --workspaces --if-present",
    "typecheck:core": "tsc --noEmit",
    "lint": "eslint src shared cli/src cli/tests webview-ui/src",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ui": "npm run test:ui:typecheck && playwright test --config tests/ui/playwright.config.ts",
    "test:ui:typecheck": "tsc --noEmit -p tests/ui/tsconfig.json",
    "test:ui:update": "playwright test --config tests/ui/playwright.config.ts --update-snapshots",
    "test:ui:report": "playwright show-report tests/ui/artifacts/report",
    "test:vscode": "node tests/vscode/run.mjs",
    "test:watch": "vitest",
    "perf:baseline": "node scripts/run-performance-baseline.mjs",
    "perf:baseline:quick": "node scripts/run-performance-baseline.mjs --quick",
    "perf:baseline:json": "node scripts/run-performance-baseline.mjs --json",
    "perf:browser": "node scripts/run-browser-performance.mjs",
    "perf:vscode": "node scripts/run-vscode-performance.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "repo:check": "node scripts/check-repository-harness.mjs",
    "design:check": "designmd lint DESIGN.md && node scripts/check-design-contract.mjs",
    "verify:fast": "npm run version:check && npm run repo:check && npm run design:check && npm run validators:check && npm run typecheck && npm run lint && npm test",
    "verify:build": "npm run build:all",
    "verify:ui:browser": "playwright install chromium",
    "verify:ui": "npm run verify:ui:browser && npm run test:ui",
    "verify:vscode": "npm run build && npm run test:vscode",
    "verify:package:vscode": "npm run package && node scripts/verify-vsix-package.mjs",
    "verify:package:vscode:host": "node scripts/verify-vsix-package.mjs --extension-host",
    "verify:package:cli": "npm run package:cli && node scripts/verify-cli-package.mjs",
    "verify:all": "npm run verify:fast && npm run verify:build && npm run verify:ui && npm run verify:vscode && npm run verify:package:vscode && npm run verify:package:cli",
    "check": "npm run verify:fast",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "validators:generate": "node scripts/generate-document-validators.mjs",
    "validators:check": "node scripts/generate-document-validators.mjs --check",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "npm run build --workspace=webview-ui -- --watch",
    "watch": "npm-run-all --parallel watch:ext watch:webview",
    "clean:dist": "node -e \"const fs=require('fs'),p=require('path'),d='dist';fs.readdirSync(d).filter(f=>f.endsWith('.map')).forEach(f=>fs.rmSync(p.join(d,f)));const a=p.join(d,'webview','assets');try{fs.readdirSync(a).filter(f=>f.startsWith('KaTeX')&&f.endsWith('.ttf')).forEach(f=>fs.rmSync(p.join(a,f)))}catch{}\"",
    "vscode:prepublish": "npm run build && npm run clean:dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.62.1",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code-block": "3.30.5",
    "@tiptap/extension-color": "3.30.5",
    "@tiptap/extension-highlight": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-subscript": "3.30.5",
    "@tiptap/extension-superscript": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-table-cell": "3.30.5",
    "@tiptap/extension-table-header": "3.30.5",
    "@tiptap/extension-table-row": "3.30.5",
    "@tiptap/extension-task-item": "3.30.5",
    "@tiptap/extension-task-list": "3.30.5",
    "@tiptap/extension-text-align": "3.30.5",
    "@tiptap/extension-text-style": "3.30.5",
    "@tiptap/extension-underline": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "highlight.js": "^11.12.0",
    "jszip": "3.10.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
