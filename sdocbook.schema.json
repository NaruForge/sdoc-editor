{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdoc.dev/schema/sdocbook.json",
  "title": "Structured Document Book (.sdocbook)",
  "description": "Versioned Book manifest for composing and reproducibly publishing .sdoc documents.",
  "oneOf": [
    { "$ref": "#/definitions/bookV1_0" },
    { "$ref": "#/definitions/bookV1_1" }
  ],
  "definitions": {
    "bookV1_0": {
      "type": "object",
      "required": ["sdocBook", "documents"],
      "properties": {
        "sdocBook": { "const": "1.0" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" },
        "counterPolicy": { "$ref": "#/definitions/counterPolicy" },
        "documents": { "$ref": "#/definitions/documents" }
      },
      "additionalProperties": false
    },
    "bookV1_1": {
      "type": "object",
      "required": ["sdocBook", "publish", "documents"],
      "properties": {
        "sdocBook": { "const": "1.1" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" },
        "counterPolicy": { "$ref": "#/definitions/counterPolicy" },
        "publish": { "$ref": "#/definitions/publishProfileV1" },
        "documents": { "$ref": "#/definitions/documents" }
      },
      "additionalProperties": false
    },
    "counterPolicy": {
      "type": "string",
      "enum": ["continue", "reset"],
      "default": "continue"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/documentEntry" }
    },
    "documentEntry": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+\\.sdoc$",
          "description": "Book-relative path to a .sdoc file."
        },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "publishProfileV1": {
      "type": "object",
      "required": ["profileVersion", "settings", "theme", "html", "pdf", "diagrams"],
      "properties": {
        "profileVersion": { "const": "1" },
        "settings": { "$ref": "#/definitions/publishSettingsV1" },
        "theme": { "$ref": "#/definitions/publishThemeV1" },
        "html": { "$ref": "#/definitions/publishHtmlV1" },
        "pdf": { "$ref": "#/definitions/publishPdfV1" },
        "diagrams": { "$ref": "#/definitions/publishDiagramsV1" },
        "outputDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$",
          "description": "Optional Book-relative output directory."
        }
      },
      "additionalProperties": false
    },
    "publishSettingsV1": {
      "type": "object",
      "required": [
        "headingNumbering",
        "headingStartNumber",
        "headingDecoration",
        "headingH1Color",
        "headingH2Color",
        "headingH3Color",
        "headingH4Color",
        "headingH5Color",
        "headingH6Color",
        "captionStyle",
        "captionNumbering",
        "equationNumbering",
        "crossRefIncludeCaption"
      ],
      "properties": {
        "headingNumbering": { "type": "boolean" },
        "headingStartNumber": { "type": "integer", "minimum": 0 },
        "headingDecoration": { "type": "boolean" },
        "headingH1Color": { "$ref": "#/definitions/color" },
        "headingH2Color": { "$ref": "#/definitions/color" },
        "headingH3Color": { "$ref": "#/definitions/color" },
        "headingH4Color": { "$ref": "#/definitions/color" },
        "headingH5Color": { "$ref": "#/definitions/color" },
        "headingH6Color": { "$ref": "#/definitions/color" },
        "captionStyle": { "type": "string", "enum": ["ieee", "iso", "modern", "korean"] },
        "captionNumbering": { "type": "string", "enum": ["sequential", "hierarchical"] },
        "equationNumbering": { "type": "string", "enum": ["sequential", "hierarchical"] },
        "crossRefIncludeCaption": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "publishThemeV1": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "const": "default-v1" },
        "cssPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+\\.[cC][sS][sS]$",
          "description": "Optional Book-relative custom CSS file; the CSS extension is case-insensitive."
        }
      },
      "additionalProperties": false
    },
    "publishHtmlV1": {
      "type": "object",
      "required": ["selfContained"],
      "properties": {
        "selfContained": { "type": "string", "enum": ["none", "images-only", "full"] }
      },
      "additionalProperties": false
    },
    "publishPdfV1": {
      "type": "object",
      "required": ["scale"],
      "properties": {
        "scale": { "type": "number", "minimum": 10, "maximum": 200 }
      },
      "additionalProperties": false
    },
    "publishDiagramsV1": {
      "type": "object",
      "required": ["failurePolicy"],
      "properties": {
        "failurePolicy": { "type": "string", "enum": ["fail", "source-fallback"] }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    }
  }
}
